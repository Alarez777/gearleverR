<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gearlever-r">
    <schema id="io.github.alarez777.GearLeverR" path="/io/github/alarez777/GearLeverR/">
        <key name="appimages-default-folder" type="s">
            <default>"~/AppImages"</default>
        </key>
        <key name="move-appimage-on-integration" type="b">
            <default>true</default>
        </key>
        <key name="exec-as-name-for-terminal-apps" type="b">
            <default>false</default>
        </key>
        <key name="debug-logs" type="b">
            <default>false</default>
        </key>
        <key name="first-run" type="b">
            <default>true</default>
        </key>
        <key name="manage-files-outside-default-folder" type="b">
            <default>true</default>
        </key>
        <key name="is-maximized" type="b">
            <default>false</default>
        </key>
        <key name="fetch-updates-in-background" type="b">
            <default>false</default>
        </key>
        <key name="preview-minimal-ui" type="b">
            <default>true</default>
        </key>
        <key name="block-unsafe-extractor" type="b">
            <default>true</default>
        </key>
        <key name="github-token-cipher" type="s">
            <default>""</default>
            <summary>Encrypted GitHub token</summary>
            <description>Machine and user bound AES-256-GCM blob used when no Secret Service keyring is available. Managed from the GitHub section in Preferences.</description>
        </key>
    </schema>
</schemalist>
