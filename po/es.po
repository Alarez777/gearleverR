msgstr "El token es válido: caduca el {expires_at}"

msgid ""
"GitHub authentication failed (401). Check your token in Preferences → GitHub."
msgstr ""
"Falló la autenticación de GitHub (401). Revisa tu token en Preferencias → "
"GitHub."

msgid "Open Preferences"
msgstr "Abrir Preferencias"

msgid "GitHub token expired or invalid"
msgstr "El token de GitHub ha caducado o no es válido"

