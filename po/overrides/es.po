msgstr "Ejecutándose en modo extracción"

msgid "Check FUSE"
msgstr "Comprobar FUSE"

msgid "System"
msgstr "Sistema"

msgid "Mounting"
msgstr "Montaje"

msgid "Gear LeverR needs FUSE to mount the AppImage instead of extracting it."
msgstr "Gear LeverR necesita FUSE para montar la AppImage en lugar de extraerla."

msgid "FUSE device"
msgstr "Dispositivo FUSE"

msgid "The kernel device AppImages use to mount their filesystem."
msgstr "El dispositivo del kernel que usan las AppImages para montar su sistema de archivos."

msgid "FUSE 3"
msgstr "FUSE 3"

msgid "The fusermount3 helper. Gear LeverR can use it or fusermount."
msgstr "La herramienta fusermount3. Gear LeverR puede usarla o usar fusermount."

msgid "FUSE 2"
msgstr "FUSE 2"

msgid "Needed by AppImages built with the older runtime. Gear LeverR does not use it."
msgstr "Lo necesitan las AppImages creadas con el runtime antiguo. Gear LeverR no lo usa."

msgid "FUSE documentation"
msgstr "Documentación de FUSE"

msgid "How to install FUSE on your distribution"
msgstr "Cómo instalar FUSE en tu distribución"

