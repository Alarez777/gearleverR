#!/bin/bash
# Gear LeverR launcher for the AppImage builds.
#
# The default variant links against the distribution's GTK4 and libadwaita,
# so a missing library is reported here instead of as a dynamic-loader error.
# The gtk-included variant ships those libraries and their resources inside the
# AppImage, where linuxdeploy installs the environment hooks consumed below.
set -eu

HERE=$(dirname "$(readlink -f "$0")")
APPDIR="$HERE"
export APPDIR

# Prefer the bundled libraries when they exist. linuxdeploy writes them to
# usr/lib; the multiarch paths cover distributions that use those directories.
for dir in "$HERE/usr/lib" "$HERE/usr/lib/x86_64-linux-gnu" \
    "$HERE/usr/lib/aarch64-linux-gnu" "$HERE/lib"; do
    if [ -d "$dir" ]; then
        LD_LIBRARY_PATH="$dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
done
export LD_LIBRARY_PATH
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# The linuxdeploy GTK hook exports GTK_THEME (Adwaita:light or Adwaita:dark)
# and GDK_BACKEND=x11. libadwaita only loads its own stylesheet when GTK_THEME
# is unset, so any value leaves the window unstyled and hides the system color
# scheme. That includes the value inherited from the process that started us,
# for example a file manager with a custom GTK3 theme. Drop it and let
# libadwaita follow org.gnome.desktop.interface color-scheme, as the Flatpak
# build of the original Gear Lever does. Forcing X11 also bypasses Wayland, so
# the hook's GDK_BACKEND is dropped while a value chosen by the user is kept.
user_gdk_backend=${GDK_BACKEND-}

# linuxdeploy-plugin-gtk prepares GTK_PATH, GDK_PIXBUF_MODULE_FILE,
# GSETTINGS_SCHEMA_DIR and similar variables here.
if [ -d "$HERE/apprun-hooks" ]; then
    for hook in "$HERE"/apprun-hooks/*.sh; do
        if [ -r "$hook" ]; then
            # shellcheck source=/dev/null
            . "$hook"
        fi
    done
fi

unset GTK_THEME

if [ -n "$user_gdk_backend" ]; then
    export GDK_BACKEND="$user_gdk_backend"
else
    unset GDK_BACKEND
fi

fail() {
    printf 'Gear LeverR: %s\n' "$1" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Gear LeverR" --text="$1" >/dev/null 2>&1 || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Gear LeverR" --error "$1" >/dev/null 2>&1 || true
    fi
    exit 1
}

BUNDLED=0
for lib in \
    "$HERE/usr/lib/libgtk-4.so.1" \
    "$HERE/usr/lib/x86_64-linux-gnu/libgtk-4.so.1" \
    "$HERE/usr/lib/aarch64-linux-gnu/libgtk-4.so.1"; do
    if [ -e "$lib" ]; then
        BUNDLED=1
        break
    fi
done

# Escape hatch for testing inside containers without ldconfig.
if [ "${GEARLEVER_R_SKIP_DEPS:-0}" != "1" ] && [ "$BUNDLED" != "1" ]; then
    if ! ldconfig -p 2>/dev/null | grep -q 'libgtk-4\.so\.1'; then
        fail "GTK 4 is not installed. Install your distribution's gtk4 package (4.8 or newer) and run Gear LeverR again."
    fi

    if ! ldconfig -p 2>/dev/null | grep -q 'libadwaita-1\.so\.0'; then
        fail "libadwaita is not installed. Install your distribution's libadwaita package (1.2 or newer) and run Gear LeverR again."
    fi
fi

if [ -d "$HERE/usr/share/glib-2.0/schemas" ]; then
    export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
fi
export GEARLEVER_R_LOCALEDIR="$HERE/usr/share"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# The bundled dwarfsextract reads DwarFS metadata without running the inspected
# AppImage. Keep it ahead of any system copy; launch.rs removes this entry from
# the environment of the applications Gear LeverR starts.
export PATH="$HERE/usr/bin${PATH:+:$PATH}"

BIN="$HERE/gearlever-r"
if [ ! -x "$BIN" ]; then
    BIN="$HERE/usr/bin/gearlever-r"
fi

exec "$BIN" "$@"
